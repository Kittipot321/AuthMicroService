{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AuthMicroservice": {
    "Database": {
      "Provider": "InMemory",
      "ConnectionString": "AuthMicroserviceTests",
      "AutoMigrate": true,
      "SeedDefaults": true
    },
    "Jwt": {
      "Issuer": "AuthMicroservice.Tests",
      "Audience": "AuthMicroservice.Tests.Clients",
      "Key": "integration-test-key-must-be-at-least-32-chars-long",
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 7,
      "ClockSkewSeconds": 30
    },
    "Email": {
      "Enabled": true,
      "FromAddress": "no-reply@tests.local",
      "Smtp": { "Host": "test", "Port": 25 }
    },
    "ExternalProviders": {
      "Google": {
        "Enabled": true,
        "ClientId": "test-google-client-id.apps.googleusercontent.com"
      },
      "Microsoft": {
        "Enabled": true,
        "ClientId": "test-microsoft-client-id",
        "TenantId": "common"
      },
      "Line": {
        "Enabled": true,
        "ChannelId": "test-line-channel-id",
        "VerifyEndpoint": "https://api.line.me/oauth2/v2.1/verify"
      }
    },
    "Identity": {
      "SignIn": { "RequireConfirmedEmail": false },
      "Password": {
        "RequiredLength": 8,
        "RequireDigit": true,
        "RequireLowercase": true,
        "RequireUppercase": true,
        "RequireNonAlphanumeric": true
      },
      "Lockout": { "MaxFailedAccessAttempts": 3, "DefaultLockoutMinutes": 15 }
    },
    "TokenLinks": {
      "EmailVerificationBaseUrl": "http://localhost/verify",
      "PasswordResetBaseUrl": "http://localhost/reset"
    },
    "EnableSwagger": false
  }
}
