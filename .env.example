# Copy to .env and fill in secrets. .env is gitignored.

# JWT signing key — must be at least 32 characters.
JWT_KEY=please-generate-a-32-plus-character-random-secret

# SQL Server SA password used by docker-compose.
MSSQL_SA_PASSWORD=Your_password123

# Google OAuth (optional). Set GOOGLE_OAUTH_ENABLED=true and provide a client id from
# https://console.cloud.google.com/apis/credentials to accept Google id_token logins at
# POST /auth/external/google. Leave disabled to keep the endpoint 404.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
