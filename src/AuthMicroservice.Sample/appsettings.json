{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuthMicroservice": {
    "Otp": {
      "CodeLength": 6,
      "ExpirationMinutes": 10,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "EmailVerification": { "Enabled": true },
      "LoginTwoFactor": { "Enabled": true }
    }
  }
}
