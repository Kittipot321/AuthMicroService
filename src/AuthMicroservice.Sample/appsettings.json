{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuthMicroservice": {
    "Otp": {
      "CodeLength": 6,
      "ExpirationMinutes": 10,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "LoginTwoFactor": { "Enabled": true }
    },
    "EmailVerification": {
      "Mode": "Link",
      "LinkBaseUrl": "http://localhost:5173/verify-email"
    }
  }
}
