<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AuthMicroservice.Migrations.SqlServer</RootNamespace>
    <AssemblyName>AuthMicroservice.Migrations.SqlServer</AssemblyName>
    <PackageId>Kittipot.AuthMicroservice.Migrations.SqlServer</PackageId>
    <IsPackable>true</IsPackable>
    <Description>SQL Server EF Core migrations for AuthMicroservice.Core. Install alongside AuthMicroservice.Core when using the SQL Server provider.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthMicroservice.Core\AuthMicroservice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
