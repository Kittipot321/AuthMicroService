<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AuthMicroservice.Core</RootNamespace>
    <AssemblyName>AuthMicroservice.Core</AssemblyName>
    <PackageId>Kittipot.AuthMicroservice.Core</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Reusable authentication library for ASP.NET Core — JWT + refresh tokens, Identity, email verification and password reset.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />

    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />

    <PackageReference Include="MailKit" />
    <PackageReference Include="MimeKit" />

    <PackageReference Include="Google.Apis.Auth" />

    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="FluentValidation.AspNetCore" />

    <PackageReference Include="Swashbuckle.AspNetCore" />

    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\*.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuthMicroservice.UnitTests" />
    <InternalsVisibleTo Include="AuthMicroservice.IntegrationTests" />
  </ItemGroup>

</Project>
